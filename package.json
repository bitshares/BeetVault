{
  "name": "beeteos",
  "productName": "BeetEOS Blockchain Companion",
  "version": "1.3.01",
  "apiversion": 3,
  "description": "BeetEOS is a stand-alone key-manager and signing app for EOS and BTS based blockchains.",
  "author": "BeetEOS team <nftea.gallery@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/beetapp/beeteos",
  "repository": "github:beetapp/beeteos",
  "main": "app/background.js",
  "browser": {
    "app": "app/app.js",
    "modal": "app/modal.js",
    "receipt": "app/receipt.js",
    "error": "app/error.js"
  },
  "build": {
    "appId": "beeteos",
    "productName": "BeetEOS Blockchain Companion",
    "artifactName": "BeetEOSSetup.${ext}",
    "files": [
      "app/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Utility",
      "target": [
        "deb",
        "AppImage"
      ],
      "mimeTypes": [
        "x-scheme-handler/rawbeeteos",
        "x-scheme-handler/beeteos"
      ],
      "executableName": "beeteos"
    }
  },
  "scripts": {
    "start": "node build/start.js",
    "compile": "webpack --config=build/webpack.main.config.js --config=build/webpack.renderer.config.js --config=build/webpack.preload.config.js --env=production",
    "build": "npm run compile && electron-builder --publish never",
    "release": "npm run compile && electron-builder --publish never",
    "dist:macos-latest": "npm run-script compile && electron-builder -m --publish never",
    "dist:windows-latest": "npm run-script compile && electron-builder -w --publish never",
    "dist:ubuntu-latest": "npm run-script compile && electron-builder -l --publish never",
    "lint": "npm run-script eslint --ext .js,.vue src",
    "lintFix": "npm run-script eslint --ext .js,.vue src --fix"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@lucide/vue": "^1.26.0",
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "bitsharesjs": "https://github.com/bitshares/bitsharesjs#develop",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dexie": "^4.4.4",
    "embla-carousel-vue": "^8.6.0",
    "eosjs": "^22.1.0",
    "eosjs-ecc": "^4.0.7",
    "lzma": "^2.3.2",
    "mitt": "^3.0.1",
    "query-string": "^9.4.1",
    "reka-ui": "^2.10.1",
    "simple-websocket": "^9.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typeface-rajdhani": "1.1.13",
    "typeface-roboto": "1.1.13",
    "uuid": "^14.0.1",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-i18n": "11",
    "vue-input-otp": "^0.3.2",
    "vue-qrcode-reader": "^5.7.3",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "vuex": "^4.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@soda/friendly-errors-webpack-plugin": "^1.8.1",
    "@tailwindcss/postcss": "^4.3.3",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "file-loader": "^6.2.0",
    "postcss": "^8.5.23",
    "postcss-loader": "^8.2.1",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "source-map-support": "^0.5.21",
    "style-loader": "^4.0.0",
    "vue-loader": "^17.4.2",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
